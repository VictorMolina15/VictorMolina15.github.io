---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ProjectCard from '../components/ProjectCard.tsx';

// Importamos el JSON directamente (Astro lo parsea automáticamente)
import projectsData from '../data/projects.json';
---

<Layout title="Victor Molina | Dev & Artist">
	<Navbar client:load />

	<!-- Hero Section Temporal -->
	<header class="pt-40 pb-20 px-8 border-b border-[#222] relative overflow-hidden">
		<!-- Fondo de cuadrícula sutil -->
		<div class="absolute inset-0 bg-[linear-gradient(to_right,#111_1px,transparent_1px),linear-gradient(to_bottom,#111_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"></div>
		
		<div class="max-w-7xl mx-auto">
			<span class="text-[#ff4500] font-mono text-sm tracking-[0.2em] uppercase mb-4 block">
				System Online
			</span>
			<h1 class="text-6xl md:text-8xl font-black uppercase tracking-tighter text-white leading-[0.85]">
				Building <br/>
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-[#555]">
					Digital Realities
				</span>
			</h1>
		</div>
	</header>

	<!-- Projects Section -->
	<main class="w-full max-w-[1600px] mx-auto border-x border-[#222]">
		{projectsData.map((project, index) => (
			<ProjectCard project={project} index={index} client:visible />
		))}
	</main>
</Layout>