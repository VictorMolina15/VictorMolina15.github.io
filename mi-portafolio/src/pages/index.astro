---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ProjectCard from '../components/ProjectCard.tsx';
import HeroMask from '../components/HeroMask.tsx';
import projectsData from '../data/projects.json';
---

<Layout title="Victor Molina | Portfolio">
	<Navbar client:load />

    <HeroMask client:only="react" />

	<main class="w-full max-w-[1600px] mx-auto border-x border-cyber-grid-light dark:border-cyber-grid bg-white dark:bg-cyber-black transition-colors duration-300">
		{projectsData.map((project, index) => (
			<ProjectCard project={project} index={index} client:visible />
		))}
	</main>
</Layout>