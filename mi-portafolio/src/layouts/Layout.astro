---
import "../styles/global.css";

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Portafolio de Desarrollo y Multimedia"
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>

		<script is:inline>
			// Inicializar tema al cargar la página
			(function () {
				function getCurrentTheme() {
					if (localStorage.getItem("theme")) {
						return localStorage.getItem("theme");
					}
					if (
						window.matchMedia("(prefers-color-scheme: dark)")
							.matches
					) {
						return "dark";
					}
					return "light";
				}

				function applyTheme(theme) {
					if (theme === "dark") {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
					localStorage.setItem("theme", theme);
				}

				const theme = getCurrentTheme();
				applyTheme(theme);
			})();
		</script>
	</head>
	<body class="bg-gray-50 text-gray-900 dark:bg-cyber-black dark:text-gray-100 transition-colors duration-300 selection:bg-primary selection:text-gray-950 cursor-crosshair">
	<slot /> 
</body>
</html>
